// Exports every kind of symbol that can be imported and renamed with `as`.

const MAX_POINTS : int32 = 100;

struct Point {
    int32 x;
    int32 y;
}

extend Point {
    fn norm(&self) int32 {
        ret self.x + self.y;
    }
}

type PointAlias = Point;

enum Color {
    Red,
    Green,
    Blue,
}

trait Area {
    fn area(&self) int32;
}

impl Area for Point {
    fn area(&self) int32 {
        ret self.norm();
    }
}

fn sqr(int32 v) int32 {
    ret v * v;
}

fn origin() Point {
    return Point { 0, 0 };
}